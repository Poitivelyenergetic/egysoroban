rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isSuperAdmin() {
      return isVerified()
        && exists(/databases/$(database)/documents/admins/$(myEmail()))
        && get(/databases/$(database)/documents/admins/$(myEmail())).data.role == 'superadmin';
    }
    function isAdminOrSuper() {
      return isVerified()
        && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function isApprovedTeacher() {
      return isVerified()
        && exists(/databases/$(database)/documents/teachers/$(myEmail()))
        && get(/databases/$(database)/documents/teachers/$(myEmail())).data.status == 'approved';
    }
    function isStaff() {
      return isAdminOrSuper() || isApprovedTeacher();
    }

    // Student applications — anyone can submit one (the public apply form).
    // Only staff (admin, superadmin, or an approved teacher) can view or update
    // them; only admin/superadmin can delete one.
    match /applications/{id} {
      allow create: if true;
      allow read, update: if isStaff();
      allow delete: if isAdminOrSuper();
    }

    // Teacher applications — anyone can submit one (the public teach form).
    // Only admin/superadmin can review, approve, or reject them.
    match /teacherApplications/{id} {
      allow create: if true;
      allow read, update: if isAdminOrSuper();
      allow delete: if isSuperAdmin();
    }

    // admins/{email} grants admin or superadmin access. A signed-in user may
    // read their own doc (to check their own role); only a superadmin may list
    // the whole collection or write to any doc (add/remove/promote admins).
    match /admins/{email} {
      allow get: if isSignedIn() && myEmail() == email;
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // teachers/{email} grants teacher access once status == "approved". A
    // signed-in user may read their own doc; admin/superadmin may read or
    // write any doc (approving a teacher application creates this doc).
    match /teachers/{email} {
      allow get: if isSignedIn() && myEmail() == email;
      allow list: if isAdminOrSuper();
      allow read: if isAdminOrSuper() || (isSignedIn() && myEmail() == email);
      allow write: if isAdminOrSuper();
    }

    // staffProfiles/{email} holds the username/phone a staff member sets for
    // themselves when creating their login account. Anyone signed in may
    // write only their own profile; any signed-in user may read profiles.
    match /staffProfiles/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myEmail() == email;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
