rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // One hardcoded exception so the dev/test admin account (which has no real
    // inbox to click a verification link with) can still be used to test admin
    // features. Still requires an admins/{email} doc to exist like any other
    // admin — this only skips the email_verified check for this one address.
    function isDevAdminException() {
      return isSignedIn() && myEmail() == 'developer1-admin@egysoroban.com';
    }
    // The top role is called "developer". It was "superadmin" until the rename,
    // and documents created before that still carry the old string — so both
    // are accepted here. This is not optional politeness: the rules are what
    // permit writing admins/ at all, so rejecting the old value before the last
    // document is migrated would lock the existing developer out of the one
    // collection needed to migrate it. The app rewrites the stored value on
    // sight (migrateLegacyDeveloperRole); once no document holds 'superadmin'
    // any more, that half of this check can be dropped.
    function isDeveloper() {
      return (isVerified() || isDevAdminException())
        && exists(/databases/$(database)/documents/admins/$(myEmail()))
        && (
          get(/databases/$(database)/documents/admins/$(myEmail())).data.role == 'developer'
          || get(/databases/$(database)/documents/admins/$(myEmail())).data.role == 'superadmin'
        );
    }
    function isAdminOrDeveloper() {
      return (isVerified() || isDevAdminException())
        && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function isApprovedTeacher() {
      return isVerified()
        && exists(/databases/$(database)/documents/teachers/$(myEmail()))
        && get(/databases/$(database)/documents/teachers/$(myEmail())).data.status == 'approved';
    }
    function isStaff() {
      return isAdminOrDeveloper() || isApprovedTeacher();
    }

    // Student applications — anyone can submit one (the public apply form).
    // Only staff (admin, developer, or an approved teacher) can view or update
    // them; only admin/developer can delete one.
    match /studentApplications/{id} {
      allow create: if true;
      allow read, update: if isStaff();
      allow delete: if isAdminOrDeveloper();
    }

    // applications/{id} is the old (pre-rename) collection name. Left
    // read-only for staff so the one-time migration into studentApplications
    // can run; no longer accepts new submissions.
    match /applications/{id} {
      allow read: if isStaff();
    }

    // Teacher applications — anyone can submit one (the public teach form).
    // Only admin/developer can review, approve, or reject them.
    match /teacherApplications/{id} {
      allow create: if true;
      allow read, update: if isAdminOrDeveloper();
      allow delete: if isDeveloper();
    }

    // admins/{email} grants admin or developer access. A signed-in user may
    // read their own doc (to check their own role); only a developer may list
    // the whole collection or write to any doc (add/remove/promote admins).
    match /admins/{email} {
      allow get: if isSignedIn() && myEmail() == email;
      allow list: if isDeveloper();
      allow write: if isDeveloper();
    }

    // teachers/{email} grants teacher access once status == "approved". A
    // signed-in user may read their own doc; admin/developer may read or
    // write any doc (approving a teacher application creates this doc).
    match /teachers/{email} {
      allow get: if isSignedIn() && myEmail() == email;
      allow list: if isAdminOrDeveloper();
      allow read: if isAdminOrDeveloper() || (isSignedIn() && myEmail() == email);
      allow write: if isAdminOrDeveloper();
    }

    // staffProfiles/{email} holds the username/phone a staff member sets for
    // themselves when creating their login account. Anyone signed in may write
    // their own profile; admin/developer may also write someone else's, which
    // is what lets an admin fill in the name and phone when they create an
    // account on a new colleague's behalf.
    match /staffProfiles/{email} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && myEmail() == email) || isAdminOrDeveloper();
    }

    // parentAccounts/{email} and studentAccounts/{email} record which group a
    // self-signed-up Parent Portal account belongs to (chosen at signup) — a
    // lightweight registry so staff can see who signed up as what and link
    // them to the right students/{id} record. Anyone signed in may write only
    // their own entry; staff (or the account owner) may read it.
    match /parentAccounts/{email} {
      allow read: if isStaff() || (isSignedIn() && myEmail() == email);
      allow write: if isSignedIn() && myEmail() == email;
    }
    match /studentAccounts/{email} {
      allow read: if isStaff() || (isSignedIn() && myEmail() == email);
      allow write: if isSignedIn() && myEmail() == email;
    }

    // students/{id} holds a child's level, attendance, homework, and exam
    // history. Admin/developer have full access to every record (including
    // assigning a teacher). An approved teacher may only read/update the
    // records they've actually been assigned (teacherEmail == their email) —
    // they can't create, delete, or touch another teacher's students. A
    // parent OR the student's own account (whichever email matches, via
    // parentEmail or studentEmail) may read — never write — their own
    // record. Firestore excludes non-matching documents from query results
    // rather than erroring, so each account's query only returns what it's
    // actually linked to.
    match /students/{id} {
      allow read: if isAdminOrDeveloper()
        || (isApprovedTeacher() && resource.data.teacherEmail == myEmail())
        || (isVerified() && resource.data.parentEmail == myEmail())
        || (isVerified() && resource.data.studentEmail == myEmail());
      allow create, delete: if isAdminOrDeveloper();
      // A teacher's update may only touch the progress fields they're meant
      // to fill out — never teacherEmail/parentEmail/studentEmail/name/branch,
      // which would otherwise let them reassign themselves onto a different
      // student, unassign themselves, or grant themselves permanent parent/
      // student-style read access by setting studentEmail to their own email.
      allow update: if isAdminOrDeveloper()
        || (isApprovedTeacher() && resource.data.teacherEmail == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['levelIndex', 'attendedSessions', 'totalSessions', 'homeworkCompleted', 'homeworkAssigned', 'examHistory']
            ));
    }

    // competitionRegistrations/{id} — anyone can submit one (the public
    // competition registration form). Only staff can review/update; only
    // admin/developer can delete one.
    match /competitionRegistrations/{id} {
      allow create: if true;
      allow read, update: if isStaff();
      allow delete: if isAdminOrDeveloper();
    }

    // trialSlots/{id} are bookable free-trial time slots shown on the public
    // apply form. Anyone can read them to see availability. Only staff can
    // create or remove a slot. Booking is a narrowly-scoped update: it may
    // only increment bookedCount by exactly 1, and only while the slot is
    // active and under capacity — this lets an anonymous visitor book safely
    // without ever being able to overbook a slot or edit anything else.
    match /trialSlots/{id} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        resource.data.active == true &&
        resource.data.bookedCount < resource.data.capacity &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount']) &&
        request.resource.data.bookedCount == resource.data.bookedCount + 1
      );
    }

    // classes/{id} is the recurring weekly timetable (day of week + start time,
    // not a dated event). Any staff member may read it — a teacher needs to see
    // their own timetable, and the Calendar panel filters to their own classes
    // client-side — but only admin/developer may schedule, edit, or cancel a
    // class, so a teacher can't assign themselves work or drop someone else's.
    match /classes/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdminOrDeveloper();
    }

    // payments/{id} records one monthly-tuition payment against a student.
    // Financial records are admin-only in both directions: approved teachers
    // have no read access at all, and nothing here is ever public. Admins can
    // correct their own bookkeeping, deletion included — a mistyped payment
    // has to be removable by the person who took it, not just a developer.
    match /payments/{id} {
      allow read, create, update, delete: if isAdminOrDeveloper();
    }

    // expenses/{id} records money going out — salaries, rent, materials. Even
    // more sensitive than payments (it exposes what staff are paid), so it is
    // admin-only in every direction and never readable by a teacher.
    match /expenses/{id} {
      allow read, create, update, delete: if isAdminOrDeveloper();
    }

    // enrolledEmails/{hash} answers one question for the Parent Portal signup
    // form: does this email belong to a family we actually teach? It has to be
    // readable while signed out, because the check happens before the account
    // exists — students/ can't serve this, since a parent only gains read
    // access there after signing in and verifying, both of which come later.
    //
    // The document ID is a salted SHA-256 of the email and the document holds
    // no address, so a public `get` reveals nothing to someone who doesn't
    // already know the address they're asking about. `list` stays admin-only
    // so the directory can't be dumped, and only an admin can write it — it is
    // rebuilt from the student records themselves.
    //
    // This gate decides who may CREATE a login, not who may read a child's
    // record; that remains enforced on students/ by the parentEmail match.
    match /enrolledEmails/{hash} {
      allow get: if true;
      allow list: if isAdminOrDeveloper();
      allow write: if isAdminOrDeveloper();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
