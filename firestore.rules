rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isSuperAdmin() {
      return isVerified()
        && exists(/databases/$(database)/documents/admins/$(myEmail()))
        && get(/databases/$(database)/documents/admins/$(myEmail())).data.role == 'superadmin';
    }
    function isAdminOrSuper() {
      return isVerified()
        && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }
    function isApprovedTeacher() {
      return isVerified()
        && exists(/databases/$(database)/documents/teachers/$(myEmail()))
        && get(/databases/$(database)/documents/teachers/$(myEmail())).data.status == 'approved';
    }
    function isStaff() {
      return isAdminOrSuper() || isApprovedTeacher();
    }

    // Student applications — anyone can submit one (the public apply form).
    // Only staff (admin, superadmin, or an approved teacher) can view or update
    // them; only admin/superadmin can delete one.
    match /applications/{id} {
      allow create: if true;
      allow read, update: if isStaff();
      allow delete: if isAdminOrSuper();
    }

    // Teacher applications — anyone can submit one (the public teach form).
    // Only admin/superadmin can review, approve, or reject them.
    match /teacherApplications/{id} {
      allow create: if true;
      allow read, update: if isAdminOrSuper();
      allow delete: if isSuperAdmin();
    }

    // admins/{email} grants admin or superadmin access. A signed-in user may
    // read their own doc (to check their own role); only a superadmin may list
    // the whole collection or write to any doc (add/remove/promote admins).
    match /admins/{email} {
      allow get: if isSignedIn() && myEmail() == email;
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // teachers/{email} grants teacher access once status == "approved". A
    // signed-in user may read their own doc; admin/superadmin may read or
    // write any doc (approving a teacher application creates this doc).
    match /teachers/{email} {
      allow get: if isSignedIn() && myEmail() == email;
      allow list: if isAdminOrSuper();
      allow read: if isAdminOrSuper() || (isSignedIn() && myEmail() == email);
      allow write: if isAdminOrSuper();
    }

    // staffProfiles/{email} holds the username/phone a staff member sets for
    // themselves when creating their login account. Anyone signed in may
    // write only their own profile; any signed-in user may read profiles.
    match /staffProfiles/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myEmail() == email;
    }

    // students/{id} holds a child's level, attendance, homework, and exam
    // history. Only staff can create/edit it; a parent OR the student's own
    // account (whichever email matches, via parentEmail or studentEmail) may
    // read — never write — their own record. Firestore excludes non-matching
    // documents from query results rather than erroring, so each account's
    // query only ever returns records actually linked to it.
    match /students/{id} {
      allow read: if isStaff()
        || (isVerified() && resource.data.parentEmail == myEmail())
        || (isVerified() && resource.data.studentEmail == myEmail());
      allow write: if isStaff();
    }

    // competitionRegistrations/{id} — anyone can submit one (the public
    // competition registration form). Only staff can review/update; only
    // admin/superadmin can delete one.
    match /competitionRegistrations/{id} {
      allow create: if true;
      allow read, update: if isStaff();
      allow delete: if isAdminOrSuper();
    }

    // trialSlots/{id} are bookable free-trial time slots shown on the public
    // apply form. Anyone can read them to see availability. Only staff can
    // create or remove a slot. Booking is a narrowly-scoped update: it may
    // only increment bookedCount by exactly 1, and only while the slot is
    // active and under capacity — this lets an anonymous visitor book safely
    // without ever being able to overbook a slot or edit anything else.
    match /trialSlots/{id} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        resource.data.active == true &&
        resource.data.bookedCount < resource.data.capacity &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount']) &&
        request.resource.data.bookedCount == resource.data.bookedCount + 1
      );
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
