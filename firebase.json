{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "predeploy": ["npm run build"],
      "headers": [
        {
          "//": "dist/js and dist/css filenames are content-hashed by the build (scripts/build.js) — a changed file always gets a new URL, so these can be cached forever without ever risking stale code.",
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "//": "HTML references the hashed JS/CSS filenames, so it must always be revalidated — caching it would freeze the site on old bundle references.",
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "//": "Content that does not change behaviour can still be cached hard.",
          "source": "**/*.@(jpg|jpeg|png|gif|svg|webp|avif|ico|woff|woff2|ttf|otf|mp4|webm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000"
            }
          ]
        },
        {
          "//": "Baseline hardening headers, applied to every response. No Content-Security-Policy here: the site loads the Firebase SDK from gstatic, talks to several *.googleapis.com/*.google-analytics.com endpoints, and embeds a Google Maps iframe on the contact page, so a CSP would need every one of those origins enumerated and verified live before it could ship without breaking sign-in or the map — worth doing, but as its own change, tested against the deployed site rather than guessed here.",
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ]
    },
    {
      "target": "egysoroban",
      "public": "dist",
      "predeploy": ["npm run build"],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(jpg|jpeg|png|gif|svg|webp|avif|ico|woff|woff2|ttf|otf|mp4|webm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ]
}
